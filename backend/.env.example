# CGJobs Backend Environment Configuration

# Server Port (default: 3000, hosting platforms like Render/Railway automatically supply PORT)
PORT=3000

# Admin Authentication Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
SESSION_SECRET=cgjobs_secret_admin_session_key_2026

# Push Notifications (Firebase Cloud Messaging - FCM)
# Option 1: FCM Legacy / Server Key
FCM_SERVER_KEY=your_fcm_server_key_here
# Option 2: Firebase Project ID & Service Account (JSON file path or stringified JSON)
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# News API Configuration (https://newsapi.org)
NEWS_API_KEY=your_newsapi_org_api_key_here

# NewsData.io Configuration (https://newsdata.io)
NEWSDATA_API_KEY=your_newsdata_io_api_key_here

# Auto-sync Interval in Minutes (0 to disable auto-sync)
AUTO_SYNC_INTERVAL_MINUTES=60
